+"""G1 test-only forced Host-tier reclamation protocol for the pinned SGLang tree.
+
+This module is intentionally a scripted-runtime test. It has no production HTTP
+route and invokes the cache facade only after ordinary ``/generate`` traffic
+has made the observed state. A GPU execution becomes G1 evidence only under a
+separately frozen and approved runtime revision.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import unittest
+from collections.abc import Generator
+from dataclasses import dataclass, field
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, Callable
+from unittest.mock import patch
+
+from sglang.test.ci.ci_register import register_cuda_ci
+from sglang.test.scripted_runtime.context import ScriptedContext
+from sglang.test.scripted_runtime.test_case import ScriptedTestCase
+
+
+register_cuda_ci(est_time=420, stage="extra-a", runner_config="1-gpu-large")
+
+_PROMPT_LEN = 256
+_MAX_NEW_TOKENS = 8
+_MAX_STEPS = 400
+_LOCAL_MODEL_PATH_ENV = "TOOLGAP_G1_MODEL_PATH"
+_ENGINE_KWARGS = {
+    "chunked_prefill_size": 64,
+    "page_size": 1,
+    "enable_hierarchical_cache": True,
+    "hicache_write_policy": "write_through",
+    "enable_session_radix_cache": True,
+    "max_total_tokens": 4096,
+}
+
+
+def _require_local_model_path() -> str:
+    value = os.environ.get(_LOCAL_MODEL_PATH_ENV)
+    if not value:
+        raise RuntimeError(
+            f"{_LOCAL_MODEL_PATH_ENV} must name the sealed local model directory"
+        )
+    model_path = Path(value)
+    if not model_path.is_absolute() or not model_path.is_dir():
+        raise RuntimeError(
+            f"{_LOCAL_MODEL_PATH_ENV} must name an existing absolute directory: {value!r}"
+        )
+    return str(model_path)
+
+
+_RECORD_FIELDS = frozenset(
+    {
+        "arm",
+        "operation",
+        "target",
+        "component_qualification",
+        "priority_release",
+        "released_component_leaves",
+        "facade",
+        "nodes",
+        "freed_device_ids",
+        "route_counters",
+        "capacity",
+        "host_pool",
+    }
+)
+_SPEC_FIELD_REQUIREMENTS = {
+    "arm": "SPEC.md section 3 enabled/bypass arm identity",
+    "operation": "ROADMAP.md G1 operation identity requirement",
+    "target": "ROADMAP.md G1 requested/eligible/scheduled/completed target requirement",
+    "component_qualification": (
+        "IMPLEMENTATION_DESIGN.md section 2 Full-only prerequisite"
+    ),
+    "priority_release": "SPEC.md section 4 requirement 2",
+    "released_component_leaves": "IMPLEMENTATION_DESIGN.md section 5 rejection records",
+    "facade": "SPEC.md section 4 requirement 2",
+    "nodes": "SPEC.md section 4 requirements 2-3",
+    "freed_device_ids": "SPEC.md section 4 requirement 3",
+    "route_counters": "SPEC.md sections 3-4 immediate route exclusions",
+    "capacity": "SPEC.md sections 3-4 allocator-visible capacity samples",
+    "host_pool": "SPEC.md section 5 Host-copy rejection reservation evidence",
+}
+
+
+@dataclass
+class _RouteCounters:
+    checked_facade: int = 0
+    checked_backend: int = 0
+    physical_demote: int = 0
+    cache_owned_drain: int = 0
+    stock_evict: int = 0
+    physical_demote_node_ids: list[int] = field(default_factory=list)
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "checked_facade": self.checked_facade,
+            "checked_backend": self.checked_backend,
+            "physical_demote": self.physical_demote,
+            "cache_owned_drain": self.cache_owned_drain,
+            "stock_evict": self.stock_evict,
+            "physical_demote_node_ids": self.physical_demote_node_ids,
+        }
+
+
+def _new_record(
+    cache: Any,
+    *,
+    arm: str,
+    operation: dict[str, Any],
+    target: dict[str, Any],
+    priority_release: str,
+    released_component_leaves: int,
+    facade: dict[str, Any],
+    nodes: list[dict[str, Any]],
+    freed_device_ids: list[int],
+    counters: _RouteCounters,
+    capacity_before: dict[str, Any],
+    capacity_after: dict[str, Any],
+    host_pool: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    record = {
+        "arm": arm,
+        "operation": operation,
+        "target": target,
+        "component_qualification": {
+            "components": [component.name for component in cache.tree_components],
+            "supports_swa": cache.supports_swa(),
+            "allocator_class": type(cache.token_to_kv_pool_allocator).__name__,
+            "page_size": cache.page_size,
+        },
+        "priority_release": priority_release,
+        "released_component_leaves": released_component_leaves,
+        "facade": facade,
+        "nodes": nodes,
+        "freed_device_ids": freed_device_ids,
+        "route_counters": counters.as_dict(),
+        "capacity": {"before": capacity_before, "after": capacity_after},
+        "host_pool": {} if host_pool is None else host_pool,
+    }
+    _validate_record(record)
+    return record
+
+
+def _validate_record(record: dict[str, Any]) -> None:
+    missing = _RECORD_FIELDS - set(record)
+    assert not missing, f"G1 record missing fields: {sorted(missing)}"
+    assert set(_SPEC_FIELD_REQUIREMENTS) == _RECORD_FIELDS
+    qualification = record["component_qualification"]
+    assert qualification["components"] == ["FULL"], qualification
+    assert not qualification["supports_swa"], qualification
+    assert isinstance(qualification["allocator_class"], str), qualification
+    assert qualification["page_size"] > 0, qualification
+    operation = record["operation"]
+    assert isinstance(operation["session_id"], str), operation
+    assert isinstance(operation["supplied_generation"], int), operation
+    target = record["target"]
+    assert set(target) == {
+        "requested_node_ids",
+        "eligible_node_ids",
+        "scheduled_node_ids",
+        "completed_node_ids",
+        "before",
+        "after",
+    }, target
+    assert all(isinstance(node_id, int) for node_id in target["requested_node_ids"])
+    assert all(isinstance(node_id, int) for node_id in target["eligible_node_ids"])
+    assert all(isinstance(node_id, int) for node_id in target["scheduled_node_ids"])
+    assert all(isinstance(node_id, int) for node_id in target["completed_node_ids"])
+    assert record["priority_release"] in {"RELEASED", "NOT_RELEASED"}
+    assert record["released_component_leaves"] >= 0
+    assert isinstance(record["nodes"], list)
+    assert isinstance(record["freed_device_ids"], list)
+    assert all(isinstance(index, int) for index in record["freed_device_ids"])
+    assert set(record["route_counters"]) == {
+        "checked_facade",
+        "checked_backend",
+        "physical_demote",
+        "cache_owned_drain",
+        "stock_evict",
+        "physical_demote_node_ids",
+    }
+    for sample in record["capacity"].values():
+        assert set(sample) == {"available_size", "is_not_in_free_group"}
+        assert sample["available_size"] >= 0
+        assert sample["is_not_in_free_group"] is True
+    assert isinstance(record["host_pool"], dict)
+    json.dumps(record, sort_keys=True)
+
+
+def _capacity_sample(cache: Any) -> dict[str, Any]:
+    allocator = cache.token_to_kv_pool_allocator
+    assert allocator.is_not_in_free_group is True, allocator
+    return {
+        "available_size": allocator.available_size(),
+        "is_not_in_free_group": allocator.is_not_in_free_group,
+    }
+
+
+def _node_observations(cache: Any, node_ids: tuple[int, ...]) -> list[dict[str, Any]]:
+    full_component = cache.tree_components[0]
+    observations = []
+    for node_id in node_ids:
+        try:
+            node = cache.tree_core.node_by_id(node_id)
+        except KeyError:
+            observations.append({"node_id": node_id, "live": False})
+            continue
+        full_data = node.component_data[full_component]
+        value = full_data.value
+        observations.append(
+            {
+                "node_id": node_id,
+                "live": True,
+                "device_ids": (
+                    [] if value is None else [int(index) for index in value.tolist()]
+                ),
+                "host_committed": full_data.host_value is not None
+                and node.write_through_pending_id is None
+                and node.load_back_pending_id is None,
+                "host_value_present": full_data.host_value is not None,
+                "write_through_pending": node.write_through_pending_id is not None,
+                "load_back_pending": node.load_back_pending_id is not None,
+                "lock_refs": [data.lock_ref for data in node.component_data],
+                "session_ref": full_data.session_ref,
+                "device_leaf": node in cache.tree_core.evictable_device_leaves,
+            }
+        )
+    return observations
+
+
+def _target_record(
+    requested_node_ids: tuple[int, ...],
+    before: list[dict[str, Any]],
+    after: list[dict[str, Any]],
+    outcome: Any | None,
+) -> dict[str, Any]:
+    outcome_nodes = () if outcome is None else outcome.nodes
+    scheduled = tuple(node.node_id for node in outcome_nodes)
+    completed = tuple(
+        node.node_id for node in outcome_nodes if node.disposition == "COMPLETED"
+    )
+    eligible = tuple(
+        observation["node_id"]
+        for observation in before
+        if observation["live"]
+        and observation["host_committed"]
+        and observation["device_leaf"]
+        and not any(observation["lock_refs"])
+        and observation["session_ref"] == 1
+    )
+    return {
+        "requested_node_ids": list(requested_node_ids),
+        "eligible_node_ids": list(eligible),
+        "scheduled_node_ids": list(scheduled),
+        "completed_node_ids": list(completed),
+        "before": before,
+        "after": after,
+    }
+
+
+def _session_request(
+    t: Any,
+    session_id: str,
+    rid: str,
+    *,
+    max_new_tokens: int,
+    input_ids: list[int] | None = None,
+) -> Any:
+    """Submit an ordinary radix-native session request through the existing route."""
+    from sglang.test.scripted_runtime.context.http_post import (
+        _http_post_and_await_recv_msg,
+    )
+    from sglang.test.scripted_runtime.req_handle import ScriptedReqHandle
+
+    _http_post_and_await_recv_msg(
+        t,
+        path="/generate",
+        json={
+            "input_ids": [7] * _PROMPT_LEN if input_ids is None else input_ids,
+            "rid": rid,
+            "session_id": session_id,
+            "stream": True,
+            "sampling_params": {
+                "max_new_tokens": max_new_tokens,
+                "ignore_eos": True,
+                "temperature": 0,
+            },
+        },
+        predicate=lambda obj: getattr(obj, "rid", None) == rid,
+        description=f"request with rid {rid!r}",
+    )
+    return ScriptedReqHandle(rid=rid, context=t)
+
+
+def _session_frontier(cache: Any, session_id: str) -> tuple[int, ...]:
+    full_component = cache.components[cache.tree_components[0]]
+    return tuple(
+        sorted(node.id for node in full_component._session_leaves.get(session_id, ()))
+    )
+
+
+def _frontier_input_ids(cache: Any, node_id: int) -> list[int]:
+    node = cache.tree_core.node_by_id(node_id)
+    token_segments = []
+    while node is not cache.tree_core.root_node:
+        assert node.key is not None, node_id
+        token_segments.append(node.key.raw_token_ids())
+        node = node.parent
+    return [
+        int(token_id)
+        for segment in reversed(token_segments)
+        for token_id in segment
+    ]
+
+
+def _wait_for_settled_private_frontier(
+    t: Any, session_id: str
+) -> Generator[None, None, tuple[Any, int, tuple[int, ...]]]:
+    cache = t.scheduler.tree_cache
+    for _ in range(_MAX_STEPS):
+        node_ids = _session_frontier(cache, session_id)
+        if node_ids:
+            nodes = [cache.tree_core.node_by_id(node_id) for node_id in node_ids]
+            if _is_settled_private_frontier(cache, nodes):
+                generation = cache.session_refs._session_generations[session_id]
+                return cache, generation, node_ids
+        yield
+    raise AssertionError(
+        f"session {session_id!r} never reached a settled private frontier"
+    )
+
+
+def _is_settled_private_frontier(cache: Any, nodes: list[Any]) -> bool:
+    return all(
+        node.component_data[cache.tree_components[0]].value is not None
+        and node.component_data[cache.tree_components[0]].host_value is not None
+        and node.write_through_pending_id is None
+        and node.load_back_pending_id is None
+        and all(data.lock_ref == 0 for data in node.component_data)
+        for node in nodes
+    )
+
+
+def _reject_record(
+    cache: Any,
+    *,
+    arm: str,
+    operation: dict[str, Any],
+    requested_node_ids: tuple[int, ...],
+    target_before: list[dict[str, Any]],
+    outcome: Any,
+    counters: _RouteCounters,
+    before: dict[str, Any],
+    after: dict[str, Any],
+    host_pool: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    assert not _freed_ids(outcome), outcome
+    assert counters.physical_demote == 0, counters
+    assert counters.cache_owned_drain == 0, counters
+    assert counters.stock_evict == 0, counters
+    assert after["available_size"] == before["available_size"], (before, after, outcome)
+    record = _new_record(
+        cache,
+        arm=arm,
+        operation=operation,
+        target=_target_record(
+            requested_node_ids,
+            target_before,
+            _node_observations(cache, requested_node_ids),
+            outcome,
+        ),
+        priority_release=outcome.priority_release,
+        released_component_leaves=outcome.released_component_leaves,
+        facade={"disposition": outcome.disposition, "reason": outcome.reason},
+        nodes=_outcome_nodes(outcome),
+        freed_device_ids=[],
+        counters=counters,
+        capacity_before=before,
+        capacity_after=after,
+        host_pool=host_pool,
+    )
+    print(json.dumps(record, sort_keys=True))
+    return record
+
+
+def _outcome_nodes(outcome: Any) -> list[dict[str, Any]]:
+    return [
+        {
+            "node_id": node.node_id,
+            "disposition": node.disposition,
+            "reason": node.reason,
+            "freed_device_ids": list(node.freed_device_ids),
+        }
+        for node in outcome.nodes
+    ]
+
+
+def _freed_ids(outcome: Any) -> list[int]:
+    return [index for node in outcome.nodes for index in node.freed_device_ids]
+
+
+def _assert_priority_release(
+    cache: Any,
+    session_id: str,
+    generation: int,
+    requested_node_ids: tuple[int, ...],
+    released: Any,
+) -> None:
+    assert released is not None
+    assert released.session_id == session_id, released
+    assert released.generation == generation, released
+    assert (
+        tuple(dict(released.frontier_node_ids)["FULL"]) == requested_node_ids
+    ), released
+    assert released.released_component_leaves > 0, released
+    assert _session_frontier(cache, session_id) == (), session_id
+
+
+def _assert_checked_priority_release(
+    cache: Any,
+    session_id: str,
+    requested_node_ids: tuple[int, ...],
+    outcome: Any,
+) -> None:
+    assert outcome.priority_release == "RELEASED", outcome
+    assert outcome.released_component_leaves > 0, outcome
+    assert _session_frontier(cache, session_id) == (), session_id
+    assert tuple(node.node_id for node in outcome.nodes) == requested_node_ids, outcome
+
+
+def _assert_deferred_node_reason(outcome: Any, reason: str) -> None:
+    assert outcome.disposition == "DEFERRED", outcome
+    assert outcome.reason == "DEFERRED", outcome
+    assert outcome.nodes, outcome
+    assert {node.reason for node in outcome.nodes} == {reason}, outcome
+
+
+def _instrument_immediate_window(
+    cache: Any, counters: _RouteCounters, action: Callable[[], Any]
+) -> Any:
+    tree_core = cache.tree_core
+    original_checked = cache.checked_demote_session
+    original_backend = tree_core.demote_session_checked
+    original_demote = getattr(tree_core, "demote")
+    original_drain = cache._free_values
+    original_evict = getattr(cache, "evict")
+
+    def checked(*args, **kwargs):
+        counters.checked_facade += 1
+        return original_checked(*args, **kwargs)
+
+    def backend(*args, **kwargs):
+        counters.checked_backend += 1
+        return original_backend(*args, **kwargs)
+
+    def demote(*args, **kwargs):
+        counters.physical_demote += 1
+        node_id = args[0] if args else kwargs["node_id"]
+        counters.physical_demote_node_ids.append(node_id)
+        return original_demote(*args, **kwargs)
+
+    def drain(*args, **kwargs):
+        counters.cache_owned_drain += 1
+        return original_drain(*args, **kwargs)
+
+    def evict(*args, **kwargs):
+        counters.stock_evict += 1
+        return original_evict(*args, **kwargs)
+
+    with (
+        patch.object(cache, "checked_demote_session", side_effect=checked),
+        patch.object(tree_core, "demote_session_checked", side_effect=backend),
+        patch.object(tree_core, "demote", side_effect=demote),
+        patch.object(cache, "_free_values", side_effect=drain),
+        patch.object(cache, "evict", side_effect=evict),
+    ):
+        return action()
+
+
+class TestG1RecordSchema(unittest.TestCase):
+    def test_checked_facade_type_is_available_to_the_scripted_protocol(self):
+        source = (
+            Path(__file__).resolve().parents[3]
+            / "python/sglang/srt/mem_cache/unified_radix_cache.py"
+        ).read_text(encoding="utf-8")
+        self.assertIn(
+            "class SessionCheckedDemoteOutcome", source,
+            "the scripted G1 protocol requires the typed checked facade outcome",
+        )
+
+    def test_json_record_schema_has_all_required_observations(self):
+        cache = SimpleNamespace(
+            tree_components=(SimpleNamespace(name="FULL"),),
+            supports_swa=lambda: False,
+            token_to_kv_pool_allocator=SimpleNamespace(),
+            page_size=1,
+        )
+        record = _new_record(
+            cache,
+            arm="schema",
+            operation={"session_id": "schema", "supplied_generation": 1},
+            target={
+                "requested_node_ids": [],
+                "eligible_node_ids": [],
+                "scheduled_node_ids": [],
+                "completed_node_ids": [],
+                "before": [],
+                "after": [],
+            },
+            priority_release="NOT_RELEASED",
+            released_component_leaves=0,
+            facade={"disposition": "REJECTED", "reason": "STALE_GENERATION"},
+            nodes=[],
+            freed_device_ids=[],
+            counters=_RouteCounters(),
+            capacity_before={"available_size": 2, "is_not_in_free_group": True},
+            capacity_after={"available_size": 2, "is_not_in_free_group": True},
+        )
+        self.assertEqual(set(record), _RECORD_FIELDS)
+        self.assertEqual(set(_SPEC_FIELD_REQUIREMENTS), _RECORD_FIELDS)
+
+
+class _G1ScriptedTestCase(ScriptedTestCase):
+    ENGINE_KWARGS = _ENGINE_KWARGS
+
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.ENGINE_KWARGS = {
+            **cls.ENGINE_KWARGS,
+            "model_path": _require_local_model_path(),
+        }
+        super().setUpClass()
+
+    @staticmethod
+    def _complete_private_session(
+        t: Any, session_id: str, rid: str
+    ) -> Generator[None, None, tuple[Any, int, tuple[int, ...]]]:
+        handle = _session_request(t, session_id, rid, max_new_tokens=_MAX_NEW_TOKENS)
+        for _ in range(_MAX_STEPS):
+            if handle.finished:
+                break
+            yield
+        else:
+            raise AssertionError(f"session request {rid!r} did not finish")
+        return (yield from _wait_for_settled_private_frontier(t, session_id))
+
+
+class TestG1PreflightStartup(_G1ScriptedTestCase):
