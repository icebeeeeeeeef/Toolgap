+class TestG1HostCopyNotCommitted(_G1ScriptedTestCase):
+    ENGINE_KWARGS = {**_ENGINE_KWARGS, "skip_server_warmup": True}
+
+    def test_settled_missing_host_copy_is_deferred_without_physical_free(self):
+        self.server.execute_script(self._script_host_copy_not_committed)
+
+    @staticmethod
+    def _script_host_copy_not_committed(t: Any):
+        session_id = "g1-host-copy-not-committed"
+        cache = t.scheduler.tree_cache
+        host_pool = cache.cache_controller.mem_pool_host
+        logical_size = host_pool.logical_size
+        available_before = host_pool.available_size()
+        assert logical_size > 0, logical_size
+        assert available_before == logical_size, (available_before, logical_size)
+        reservation = host_pool.alloc(available_before)
+        assert reservation is not None, available_before
+        reserved_indices = [int(index) for index in reservation.tolist()]
+        assert len(reserved_indices) == available_before, (
+            len(reserved_indices),
+            available_before,
+        )
+        assert reserved_indices == list(range(logical_size)), reserved_indices
+        available_reserved = host_pool.available_size()
+        assert available_reserved == 0, available_reserved
+
+        handle = _session_request(
+            t,
+            session_id,
+            "g1-host-copy-not-committed-request",
+            max_new_tokens=_MAX_NEW_TOKENS,
+        )
+        for _ in range(_MAX_STEPS):
+            node_ids = _session_frontier(cache, session_id)
+            target_before_release = _node_observations(cache, node_ids)
+            if (
+                handle.finished
+                and node_ids
+                and all(
+                    observation["live"]
+                    and observation["device_ids"]
+                    and not observation["host_value_present"]
+                    and not observation["write_through_pending"]
+                    and not observation["load_back_pending"]
+                    and not any(observation["lock_refs"])
+                    and observation["session_ref"] == 1
+                    and observation["device_leaf"]
+                    for observation in target_before_release
+                )
+            ):
+                break
+            yield
+        else:
+            raise AssertionError(
+                "normal request never reached a private device-resident frontier "
+                "after Host allocation refusal"
+            )
+
+        generation = cache.session_refs._session_generations[session_id]
+        released_count = host_pool.free(reservation)
+        available_after_release = host_pool.available_size()
+        assert released_count == len(reserved_indices), (
+            released_count,
+            len(reserved_indices),
+        )
+        assert available_after_release == logical_size, (
+            available_after_release,
+            logical_size,
+        )
+
+        # No scheduler yield occurs between releasing the test reservation and
+        # invoking the checked action, so no Host-copy retry can run here.
+        target_before = _node_observations(cache, node_ids)
+        assert target_before == target_before_release, (
+            target_before_release,
+            target_before,
+        )
+        counters = _RouteCounters()
+        before = _capacity_sample(cache)
+        outcome = _instrument_immediate_window(
+            cache,
+            counters,
+            lambda: cache.checked_demote_session(session_id, generation),
+        )
+        after = _capacity_sample(cache)
+        _assert_checked_priority_release(cache, session_id, node_ids, outcome)
+        _assert_deferred_node_reason(outcome, "HOST_COPY_NOT_COMMITTED")
+        assert counters.checked_facade == 1, counters
+        assert counters.checked_backend >= 1, counters
+        _reject_record(
+            cache,
+            arm="reject_host_copy_not_committed",
+            operation={"session_id": session_id, "supplied_generation": generation},
+            requested_node_ids=node_ids,
+            target_before=target_before,
+            outcome=outcome,
+            counters=counters,
+            before=before,
+            after=after,
+            host_pool={
+                "logical_size": logical_size,
+                "available_before_reservation": available_before,
+                "reserved_indices": reserved_indices,
+                "available_while_reserved": available_reserved,
+                "release_returned": released_count,
+                "available_after_release": available_after_release,
+            },
+        )
+
