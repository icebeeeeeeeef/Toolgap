+            if (
+                all(
+                    observation["live"]
+                    and observation["device_ids"]
+                    and observation["load_back_pending"]
+                    and not observation["write_through_pending"]
+                    for observation in target_before
+                )
+                and all(
+                    any(data.lock_ref > 0 for data in node.component_data)
