+class TestG1EnabledArm(_G1ScriptedTestCase):
+    def test_enabled_checked_demotion_records_allocator_visible_release(self):
+        self.server.execute_script(self._script_enabled)
+
+    @staticmethod
+    def _script_enabled(t: ScriptedContext):
+        session_id = "g1-enabled"
+        cache, generation, target_nodes = (
+            yield from TestG1EnabledArm._complete_private_session(
+                t, "g1-enabled", "g1-enabled-request"
+            )
+        )
+        target_before = _node_observations(cache, target_nodes)
+        assert all(
+            observation["host_committed"]
+            and observation["device_leaf"]
+            and observation["device_ids"]
+            for observation in target_before
+        ), target_before
+        counters = _RouteCounters()
+        before = _capacity_sample(cache)
+        outcome = _instrument_immediate_window(
+            cache,
+            counters,
+            lambda: cache.checked_demote_session(session_id, generation),
+        )
+        after = _capacity_sample(cache)
+        _assert_checked_priority_release(cache, session_id, target_nodes, outcome)
+        assert outcome.disposition == "ACCEPTED", outcome
+        assert counters.checked_facade == 1, counters
+        assert counters.checked_backend >= 1, counters
+        assert counters.stock_evict == 0, counters
+        target_after = _node_observations(cache, target_nodes)
+        record = _new_record(
+            cache,
+            arm="enabled",
+            operation={"session_id": session_id, "supplied_generation": generation},
+            target=_target_record(target_nodes, target_before, target_after, outcome),
+            priority_release=outcome.priority_release,
+            released_component_leaves=outcome.released_component_leaves,
+            facade={"disposition": outcome.disposition, "reason": outcome.reason},
+            nodes=_outcome_nodes(outcome),
+            freed_device_ids=_freed_ids(outcome),
+            counters=counters,
+            capacity_before=before,
+            capacity_after=after,
+        )
+        print(json.dumps(record, sort_keys=True))
+
+
+class TestG1BypassArm(_G1ScriptedTestCase):
+    def test_bypass_releases_priority_without_physical_reclamation(self):
+        self.server.execute_script(self._script_bypass)
+
+    @staticmethod
+    def _script_bypass(t: ScriptedContext):
+        session_id = "g1-bypass"
+        cache, generation, target_nodes = (
+            yield from TestG1BypassArm._complete_private_session(
+                t, "g1-bypass", "g1-bypass-request"
+            )
