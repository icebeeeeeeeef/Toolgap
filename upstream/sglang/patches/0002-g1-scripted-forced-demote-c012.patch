+def _register_non_target_session_coverage(
+    cache: Any, session_id: str, target_nodes: tuple[int, ...]
+) -> tuple[int, ...]:
+    assert target_nodes, target_nodes
+    full_component = cache.tree_components[0]
+    component = cache.components[full_component]
+    nodes = tuple(cache.tree_core.node_by_id(node_id) for node_id in target_nodes)
+    assert all(
+        node.component_data[full_component].session_ref == 1 for node in nodes
+    ), target_nodes
+    assert session_id not in cache.session_refs._session_generations, session_id
+    cache.session_refs.ensure_session_generation(session_id)
+    for node in nodes:
+        component.register_session_leaf(session_id, node)
+    registered = _session_frontier(cache, session_id)
+    assert registered == target_nodes, (registered, target_nodes)
+    assert all(
+        node.component_data[full_component].session_ref == 2 for node in nodes
+    ), target_nodes
+    return registered
+
