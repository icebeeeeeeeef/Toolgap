+    def checked_demote_session(
+        self, session_id: str, generation: int
+    ) -> SessionCheckedDemoteOutcome:
+        """Release target priority and consume atomic backend demote attempts."""
+        if self.tree_components != (BASE_COMPONENT_TYPE,):
+            return SessionCheckedDemoteOutcome(
+                session_id,
+                generation,
+                "NOT_RELEASED",
+                "REJECTED",
+                0,
+                (),
+                "UNSUPPORTED_COMPONENT_SET",
+            )
