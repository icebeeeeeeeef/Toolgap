+    def demote_session_checked(self, node_id: NodeId) -> SessionDemoteExecution:
+        """Perform the final live checks and existing demote in one backend call."""
+        if self.component_types != (BASE_COMPONENT_TYPE,):
+            return SessionDemoteExecution(
+                node_id, "REJECTED", "UNSUPPORTED_COMPONENT_SET"
+            )
