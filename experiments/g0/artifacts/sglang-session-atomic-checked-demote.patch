+            component.is_evict_device_ongoing
+            for component in self.components_by_type.values()
+        ):
+            return SessionDemoteExecution(
+                node_id, "DEFERRED", "STRUCTURAL_OWNER_ACTIVE"
+            )
+        try:
+            node = self.node_by_id(node_id)
+        except KeyError:
+            return SessionDemoteExecution(node_id, "REJECTED", "NODE_NOT_LIVE")
+
+        full_data = node.component_data[BASE_COMPONENT_TYPE]
+        if full_data.value is None:
+            return SessionDemoteExecution(
+                node_id, "REJECTED", "DEVICE_VALUE_ABSENT"
+            )
+        if node.write_through_pending_id is not None:
+            return SessionDemoteExecution(
+                node_id, "DEFERRED", "WRITE_THROUGH_PENDING"
+            )
+        if node.load_back_pending_id is not None:
+            return SessionDemoteExecution(
+                node_id, "DEFERRED", "LOAD_BACK_PENDING"
+            )
+        if any(data.lock_ref > 0 for data in node.component_data):
+            return SessionDemoteExecution(node_id, "DEFERRED", "DEVICE_LOCKED")
+        if full_data.session_ref > 0:
+            return SessionDemoteExecution(
+                node_id, "DEFERRED", "NON_TARGET_SESSION_COVERAGE"
+            )
+        if not self._is_settled_full_host_duplicate(node):
+            return SessionDemoteExecution(
+                node_id, "DEFERRED", "HOST_COPY_NOT_COMMITTED"
+            )
+        if not self._is_device_leaf(node):
+            return SessionDemoteExecution(
+                node_id, "REJECTED", "NOT_CURRENT_DEVICE_LEAF"
+            )
+
+        return SessionDemoteExecution(
+            node_id=node_id,
+            disposition="COMPLETED",
+            reason="DEMOTED",
+            demote_result=self.demote(node_id),
+        )
