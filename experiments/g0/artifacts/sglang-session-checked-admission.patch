+        if node.write_through_pending_id is not None:
+            return SessionDemoteAdmission(
+                node_id, False, "WRITE_THROUGH_PENDING"
+            )
+        if node.load_back_pending_id is not None:
+            return SessionDemoteAdmission(node_id, False, "LOAD_BACK_PENDING")
