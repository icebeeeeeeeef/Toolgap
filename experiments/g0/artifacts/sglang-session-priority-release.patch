+    def release_session_priority(
+        self, session_id: str, generation: int
+    ) -> Optional[SessionPriorityRelease]:
+        """Release only this generation's priority refs without closing it."""
+        if not self.enable_session_radix_cache or session_id is None:
+            return None
+
+        if self._session_generations.get(session_id) != generation:
+            return None
+
+        frontier_node_ids = tuple(
+            (
+                component.component_type.name,
+                tuple(
+                    sorted(
+                        node.id
+                        for node in component._session_leaves.get(session_id, ())
+                    )
+                ),
+            )
+            for component in self.components
+        )
+        released_component_leaves = sum(
+            component.release_session(session_id) for component in self.components
+        )
+        return SessionPriorityRelease(
+            session_id=session_id,
+            generation=generation,
+            frontier_node_ids=frontier_node_ids,
+            released_component_leaves=released_component_leaves,
+        )
